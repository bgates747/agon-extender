# ESP-IDF 5.5.5 b774170ff46c393eeb5e495ea37936038d3f4f4f lacks the public
# usb_host_config_t.fsls_only field. Restrict the existing HS root to FS/LS
# immediately before its reset, using the reviewed Espressif HAL ordering.
# https://docs.espressif.com/projects/esp-usb/en/latest/esp32p4/usb_host.html#full-low-speed-only-host
# This isolated reproducer intentionally omits Extender's cache/diagnostic HCD
# changes and USBH task-logging change. CTRL was already cache-synchronized in
# the pinned driver. Interrupt-IN report correctness is not qualified here.
# Remove this backport only with a separately selected/qualified SDK replacement.
if(NOT DEFINED USB_MINIMAL_HCD_SOURCE)
  idf_component_get_property(usb_dir usb COMPONENT_DIR)
  idf_component_get_property(usb_target usb COMPONENT_LIB)
  set(USB_MINIMAL_HCD_SOURCE "${usb_dir}/hcd_dwc.c")
  set(USB_MINIMAL_HCD_OUTPUT "${CMAKE_BINARY_DIR}/usb-minimal/hcd_dwc.c")
endif()
file(SHA256 "${USB_MINIMAL_HCD_SOURCE}" upstream_sha)
if(NOT upstream_sha STREQUAL "33fea9059ee546d1c773fc5e86ed0c294e600e645c4c14e0788ce879f596280b")
  message(FATAL_ERROR "Unreviewed USB HCD source; minimal FSLS patch refused")
endif()
file(READ "${USB_MINIMAL_HCD_SOURCE}" original)
set(before "    usb_dwc_hal_port_toggle_reset(port->hal, true);")
set(after "    // Extender USB-only reproducer: FSLS root-reset backport, no other HCD changes.\n    if (port->hal->constant_config.hsphy_type != 0) {\n        usb_dwc_ll_hcfg_set_fsls_supp_only(port->hal->dev);\n    }\n    usb_dwc_hal_port_toggle_reset(port->hal, true);")
string(FIND "${original}" "${before}" position)
if(position LESS 0)
  message(FATAL_ERROR "Expected minimal USB root-reset anchor is absent")
endif()
string(LENGTH "${before}" before_length)
math(EXPR after_anchor "${position}+${before_length}")
string(SUBSTRING "${original}" ${after_anchor} -1 remainder)
string(FIND "${remainder}" "${before}" duplicate)
if(NOT duplicate LESS 0)
  message(FATAL_ERROR "Expected exactly one minimal USB root-reset anchor")
endif()
string(REPLACE "${before}" "${after}" patched "${original}")
get_filename_component(output_dir "${USB_MINIMAL_HCD_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${USB_MINIMAL_HCD_OUTPUT}" "${patched}")
file(SHA256 "${USB_MINIMAL_HCD_OUTPUT}" derivative_sha)
if(NOT derivative_sha STREQUAL "e26a6ecaac14fd67814b00722d8d1df39305006905fd9362c889f17cfbfd1625")
  message(FATAL_ERROR "Minimal USB derivative differs from the complete FSLS-only patch")
endif()
message(STATUS "Minimal USB FSLS-only HCD SHA256 ${derivative_sha}")
if(DEFINED usb_target)
  get_target_property(sources "${usb_target}" SOURCES)
  set(selected)
  set(replaced 0)
  foreach(source IN LISTS sources)
    if(IS_ABSOLUTE "${source}")
      set(absolute "${source}")
    else()
      set(absolute "${usb_dir}/${source}")
    endif()
    if(absolute STREQUAL USB_MINIMAL_HCD_SOURCE)
      list(APPEND selected "${USB_MINIMAL_HCD_OUTPUT}")
      math(EXPR replaced "${replaced}+1")
    else()
      list(APPEND selected "${source}")
    endif()
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one original USB HCD compile unit")
  endif()
  set_property(TARGET "${usb_target}" PROPERTY SOURCES "${selected}")
endif()
