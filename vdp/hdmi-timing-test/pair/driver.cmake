# Standalone diagnostic. Keep all IDF modifications local to this build.
function(pair_replace_source component subdir filename)
  idf_component_get_property(dir ${component} COMPONENT_DIR)
  idf_component_get_property(target ${component} COMPONENT_LIB)
  set(original "${dir}/${subdir}/${filename}")
  set(derived "${CMAKE_BINARY_DIR}/${probe}/${filename}")
  set(generator "${CMAKE_CURRENT_LIST_DIR}/patch_dpi.py")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${generator}")
  execute_process(COMMAND "${PYTHON}" "${generator}" "${original}" "${derived}" "${probe}" COMMAND_ERROR_IS_FATAL ANY)
  get_target_property(sources "${target}" SOURCES)
  set(selected)
  set(count 0)
  foreach(source IN LISTS sources)
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${dir}")
    if(absolute STREQUAL original)
      list(APPEND selected "${derived}")
      math(EXPR count "${count}+1")
    else()
      list(APPEND selected "${source}")
    endif()
  endforeach()
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one source for ${filename}")
  endif()
  set_property(TARGET "${target}" PROPERTY SOURCES "${selected}")
  target_include_directories("${target}" PRIVATE "${dir}/${subdir}" "${CMAKE_CURRENT_LIST_DIR}/../${probe}")
endfunction()
pair_replace_source(esp_lcd dsi esp_lcd_panel_dpi.c)
pair_replace_source(esp_hw_support dma dw_gdma.c)
idf_component_get_property(pair_lcd_target esp_lcd COMPONENT_LIB)
idf_component_get_property(pair_timer_target esp_timer COMPONENT_LIB)
target_link_libraries("${pair_lcd_target}" PRIVATE "${pair_timer_target}")
