# INPUT-004: complete Espressif USB1.6.0/630f1c4 host, including the dual-root
# hub/enumerator dependencies missing from the rejected PHY-only backport.
# The Python builder extracts an archive-pinned pristine component override.
# Keep SDK5.5.5 PHY/HAL and pre-v3 policy. Public fsls_only remains false because
# that HAL rejects it; adapt only the HS reset assignment and EP0 task logging.
# USB1.6.0 already owns the DMA IN cache correction. No inherited LS MMIO probe.
# Remove derivatives after qualifying an SDK/host with equivalent native fixes.
if(NOT DEFINED USB16_DIR)
  idf_component_get_property(USB16_DIR usb COMPONENT_DIR)
  idf_component_get_property(usb16_target usb COMPONENT_LIB)
  set(USB16_OUTPUT "${CMAKE_BINARY_DIR}/agon-extender-usb")
endif()
file(MAKE_DIRECTORY "${USB16_OUTPUT}")
foreach(unit IN ITEMS hcd_dwc usbh)
  if(unit STREQUAL "hcd_dwc")
    set(input_sha "f7be5cff2be70176baab93e1b4e643e1d5bd3cd56383f01cc79392c76c5adc15")
    set(output_sha "aa0e6e26981130abe1c13759c191eaaca06c5a11da1439a4d7b4d326f0d6dde8")
  else()
    set(input_sha "e4caa9cfeb665c0a04756d1eec491493ededfe0d65c449f1b14d2406c6be32bb")
    set(output_sha "7082caadb7d863540434137b8400e946c802e44be630e217d71109ae619cff3a")
  endif()
  set(source "${USB16_DIR}/src/${unit}.c")
  set(output "${USB16_OUTPUT}/${unit}.c")
  file(SHA256 "${source}" actual_sha)
  if(NOT actual_sha STREQUAL input_sha)
    message(FATAL_ERROR "Unreviewed USB1.6.0 ${unit} source")
  endif()
  execute_process(COMMAND patch --batch --fuzz=0 --silent --output "${output}"
                  "${source}" "${CMAKE_CURRENT_LIST_DIR}/../compat/usb_dual_host/${unit}.c.patch"
                  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT result EQUAL 0)
    file(REMOVE "${output}")
    message(FATAL_ERROR "USB1.6.0 ${unit} derivative failed: ${stdout} ${stderr}")
  endif()
  file(SHA256 "${output}" actual_sha)
  if(NOT actual_sha STREQUAL output_sha)
    message(FATAL_ERROR "USB1.6.0 ${unit} derivative identity differs")
  endif()
  if(DEFINED usb16_target)
    get_target_property(sources "${usb16_target}" SOURCES)
    set(selected)
    set(replacements 0)
    foreach(item IN LISTS sources)
      if(IS_ABSOLUTE "${item}")
        set(absolute "${item}")
      else()
        set(absolute "${USB16_DIR}/${item}")
      endif()
      if(absolute STREQUAL source)
        list(APPEND selected "${output}")
        math(EXPR replacements "${replacements}+1")
      else()
        list(APPEND selected "${item}")
      endif()
    endforeach()
    if(NOT replacements EQUAL 1)
      message(FATAL_ERROR "Expected exactly one USB1.6.0 ${unit} source")
    endif()
    set_property(TARGET "${usb16_target}" PROPERTY SOURCES "${selected}")
  endif()
endforeach()
