# Isolated panel derivative. Patch only the pinned DPI unit and the previously
# verified IRQ-before-clock DW-GDMA teardown. The stock IDF tree stays intact.
function(native_scanout_driver component subdir filename generator)
  idf_component_get_property(dir ${component} COMPONENT_DIR)
  idf_component_get_property(target ${component} COMPONENT_LIB)
  set(original "${dir}/${subdir}/${filename}")
  set(derived "${CMAKE_BINARY_DIR}/native-scanout/${filename}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${generator}")
  execute_process(COMMAND "${PYTHON}" "${generator}" "${original}" "${derived}" COMMAND_ERROR_IS_FATAL ANY)
  get_target_property(sources "${target}" SOURCES)
  set(selected)
  set(count 0)
  foreach(source IN LISTS sources)
    get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${dir}")
    if(absolute STREQUAL original)
      list(APPEND selected "${derived}")
      math(EXPR count "${count}+1")
    else()
      list(APPEND selected "${source}")
    endif()
  endforeach()
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one source for ${filename}")
  endif()
  set_property(TARGET "${target}" PROPERTY SOURCES "${selected}")
  target_include_directories("${target}" PRIVATE "${dir}/${subdir}" "${CMAKE_CURRENT_LIST_DIR}")
endfunction()
native_scanout_driver(esp_lcd dsi esp_lcd_panel_dpi.c "${CMAKE_CURRENT_LIST_DIR}/patch_dpi.py")
native_scanout_driver(esp_hw_support dma dw_gdma.c "${CMAKE_CURRENT_LIST_DIR}/../rolling/patch_dw_gdma.py")
# Block retirement/ready instrumentation uses esp_timer_get_time from the SDK.
idf_component_get_property(native_lcd_target esp_lcd COMPONENT_LIB)
idf_component_get_property(native_timer_target esp_timer COMPONENT_LIB)
target_link_libraries("${native_lcd_target}" PRIVATE "${native_timer_target}")
idf_component_get_property(native_timer_dir esp_timer COMPONENT_DIR)
target_include_directories("${native_lcd_target}" PRIVATE "${native_timer_dir}/include")
if(AGON_NATIVE_STARTUP_TRACE)
  target_compile_definitions("${native_lcd_target}" PRIVATE AGON_EXTENDER_NATIVE_STARTUP_TRACE=1)
endif()
