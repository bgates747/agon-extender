# FWBUG-016: isolated finite RX descriptor accounting, explicit ExExt only.
idf_component_get_property(parlio_dir esp_driver_parlio COMPONENT_DIR)
idf_component_get_property(parlio_target esp_driver_parlio COMPONENT_LIB)
set(rx_original "${parlio_dir}/src/parlio_rx.c")
set(rx_derived "${CMAKE_BINARY_DIR}/exext-parlio/parlio_rx.c")
execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/patch_parlio_rx.py" "${rx_original}" "${rx_derived}" COMMAND_ERROR_IS_FATAL ANY)
get_target_property(parlio_sources "${parlio_target}" SOURCES)
set(selected)
set(replacements 0)
foreach(source IN LISTS parlio_sources)
  if(IS_ABSOLUTE "${source}")
    set(absolute "${source}")
  else()
    set(absolute "${parlio_dir}/${source}")
  endif()
  if(absolute STREQUAL rx_original)
    list(APPEND selected "${rx_derived}")
    math(EXPR replacements "${replacements}+1")
  else()
    list(APPEND selected "${source}")
  endif()
endforeach()
if(NOT replacements EQUAL 1)
  message(FATAL_ERROR "PARLIO RX derivative did not replace exactly one source")
endif()
set_property(TARGET "${parlio_target}" PROPERTY SOURCES "${selected}")
target_include_directories("${parlio_target}" PRIVATE "${parlio_dir}/src")
