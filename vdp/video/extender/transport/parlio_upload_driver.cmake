# PORT-008 RU05-F01: explicit whole-file upload only; pristine SDK unchanged.
idf_component_get_property(parlio_upload_dir esp_driver_parlio COMPONENT_DIR)
idf_component_get_property(parlio_upload_target esp_driver_parlio COMPONENT_LIB)
set(upload_tx_original "${parlio_upload_dir}/src/parlio_tx.c")
set(upload_tx_derived "${CMAKE_BINARY_DIR}/upload-parlio/parlio_tx.c")
execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/patch_parlio_upload.py"
                "${upload_tx_original}" "${upload_tx_derived}" COMMAND_ERROR_IS_FATAL ANY)
get_target_property(parlio_upload_sources "${parlio_upload_target}" SOURCES)
set(upload_selected)
set(upload_replacements 0)
foreach(source IN LISTS parlio_upload_sources)
  if(IS_ABSOLUTE "${source}")
    set(absolute "${source}")
  else()
    set(absolute "${parlio_upload_dir}/${source}")
  endif()
  if(absolute STREQUAL upload_tx_original)
    list(APPEND upload_selected "${upload_tx_derived}")
    math(EXPR upload_replacements "${upload_replacements}+1")
  else()
    list(APPEND upload_selected "${source}")
  endif()
endforeach()
if(NOT upload_replacements EQUAL 1)
  message(FATAL_ERROR "Upload TX derivative must replace exactly one source")
endif()
set_property(TARGET "${parlio_upload_target}" PROPERTY SOURCES "${upload_selected}")
target_include_directories("${parlio_upload_target}" PRIVATE "${parlio_upload_dir}/src")
