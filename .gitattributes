# Official agon-vdp v2.16.0 is vendored byte-for-byte, including inherited
# CRLF/tab/trailing-whitespace style. Do not normalize its source merely to
# satisfy local whitespace policy. Project-owned Extender code remains strict.
vdp/video/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
vdp/vendor/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
vdp/video/extender/** whitespace=blank-at-eol,blank-at-eof,space-before-tab
# The scanline extraction retains exact upstream bytes; its source-span verifier
# checks that content. Do not strip inherited blank-line spaces from these bodies.
vdp/video/extender/display/stock_scanline.cpp whitespace=-blank-at-eol

# Qualification serial captures retain device-native bytes (including CRLF)
# so their recorded evidence hashes remain meaningful.
tests/runs/**/boot-*.log binary
