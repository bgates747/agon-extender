@@ -0,0 +1,30 @@
+// P01g diagnostic only. No production flag. Fixed payload and bounded admission.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <cstdio>
+#include <esp_heap_caps.h>
+#include <esp_timer.h>
+namespace agon_ladder {
+inline std::atomic<bool> enabled{false};
+inline uint8_t *pattern{}; inline uint32_t crcs[17]{};
+inline uint8_t nonce[8]{}; inline uint32_t length{},sequence{};
+inline uint64_t last_bucket=~uint64_t(0);
+inline bool prepare(const uint8_t *n) {
+ if(!pattern) {
+  pattern=(uint8_t*)heap_caps_malloc(196608,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
+  if(!pattern)return false;
+  uint32_t c=~0u;
+  for(unsigned i=0;i<196608;++i){pattern[i]=i&255;c^=pattern[i];for(unsigned k=0;k<8;++k)c=(c>>1)^(0xedb88320u&uint32_t(-int(c&1)));if((i+1)%12288==0)crcs[(i+1)/12288]=~c;}
+ }
+ // Preparation is outside the fixture observation window; no old send pending.
+ std::memcpy(nonce,n,8);length=unsigned(n[5])*12288;sequence=0;last_bucket=~uint64_t(0);
+ enabled.store(n[0]=='P'&&n[1]=='0'&&n[2]=='2'&&n[4]==1&&n[5]<=16);
+ return true;
+}
+inline bool admit(){if(!enabled.load())return true;auto bucket=uint64_t(esp_timer_get_time())/16667;if(bucket==last_bucket)return false;last_bucket=bucket;return true;}
+inline void put(uint8_t*p,uint32_t n){for(unsigned i=0;i<4;++i)p[i]=uint8_t(n>>(8*i));}
+inline void header(uint8_t*p){std::memcpy(p,"LDR1",4);put(p+4,1);std::memcpy(p+8,nonce,8);put(p+16,++sequence);put(p+20,length);put(p+24,uint32_t(esp_timer_get_time()));put(p+28,crcs[length/12288]);}
+inline void stop(){enabled.store(false);}
+}
