+// One instance per video connection. Zero means retain, opaque black is 0xC0.
+export class DeltaFrameDecoder {
+  constructor(){this.reset();}
+  reset(){this.reference=null;}
+  decode(buffer){
+    try {
+      let data=buffer;
+      if(buffer instanceof ArrayBuffer && buffer.byteLength>=4 &&
+         String.fromCharCode(...new Uint8Array(buffer,0,4))==='EVD1'){
+        if(buffer.byteLength<46)throw new Error('Short delta frame');
+        const view=new DataView(buffer),old=this.reference;
+        if(!old||view.getUint32(28,true)!==old.sequence||
+           view.getUint16(12,true)!==old.width||view.getUint16(14,true)!==old.height||
+           view.getUint32(24,true)!==old.presentPeriodUs)throw new Error('Missing/mismatched delta reference');
+        const copy=new Uint8Array(buffer.slice(0));copy[2]=82;
+        new DataView(copy.buffer).setUint32(28,0,true);
+        const decoded=unpackRLE2Frame(copy.buffer,true),pixels=new Uint8Array(decoded,32);
+        if(pixels.length!==old.pixels.length)throw new Error('Delta size mismatch');
+        for(let i=0;i<pixels.length;++i)pixels[i]=pixels[i]===0?old.pixels[i]:pixels[i]&63;
+        data=decoded;
+      }
+      const frame=parseFrame(data);
+      if(frame.pixelFormat===PixelFormat.RGB222 && frame.strideBytes===frame.width){
+        if(frame.pixels.some(p=>p>63))throw new Error('Invalid RGB222 pixel');
+        this.reference={...frame,pixels:frame.pixels.slice()};
+      } else this.reset();
+      return frame;
+    } catch(error){this.reset();throw error;}
+  }
+}
