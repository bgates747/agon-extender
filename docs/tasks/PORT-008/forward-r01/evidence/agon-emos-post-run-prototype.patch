diff --git a/src/serial.asm b/src/serial.asm
index 260864c..1348f04 100644
--- a/src/serial.asm
+++ b/src/serial.asm
@@ -465,12 +465,20 @@ PORT008_send:		LD	A, (_port008_acquired)
 			OR	A, A
 			JP	NZ, PORT008_unavailable
 PORT008_size_valid:
-			LD	A, (_port008_busy)
-			OR	A, A
-			JP	NZ, PORT008_unavailable
-			LD	(_port008_pointer), HL
-			LD	(_port008_length), BC
-			LD	A, I				; Preserve IEF2 like predecessor
+			LD	A, (_port008_busy)
+			OR	A, A
+			JP	NZ, PORT008_unavailable
+			LD	(_port008_pointer), HL
+			LD	(_port008_length), BC
+			; ADL-mode LD (nn),BC stores all 24 bits. The prototype
+			; contract is deliberately capped below 64 KiB, so reject a
+			; nonzero BCU after saving into correctly sized private state.
+			; Keeping the storage and check explicit prevents a two-byte BSS
+			; declaration from silently corrupting the following control byte.
+			LD	A, (_port008_length + 2)
+			OR	A, A
+			JP	NZ, PORT008_unavailable
+			LD	A, I				; Preserve IEF2 like predecessor
 			JP	PO, PORT008_iff_was_off
 			LD	A, 1
 			JR	PORT008_save_iff
@@ -504,23 +512,32 @@ PORT008_wait_ready:
 			LD	A, 1
 			JR	PORT008_finish
 
-PORT008_admitted:
-			LD	HL, (_port008_pointer)
-			LD	BC, (_port008_length)
-PORT008_byte_loop:
-			LD	A, (HL)
-			OUT0	(PC_DR), A
-			LD	A, (_port008_active_high)
-			OUT0	(PD_DR), A
-			LD	A, (_port008_active_low)
-			OUT0	(PD_DR), A			; Falling-edge sample
-			INC	HL
-			DEC	BC
-			LD	A, B
-			OR	C
-			JR	NZ, PORT008_byte_loop
-			LD	A, (_port008_idle_low)		; VALID inactive
-			OUT0	(PD_DR), A
+PORT008_admitted:
+			LD	HL, (_port008_pointer)
+			LD	BC, (_port008_length)
+			; Preserve the physically qualified PRX-06 sender cadence. VALID_N
+			; becomes active while CLOCK is high, and each byte's load and Port C
+			; write provide setup time before the falling sample edge. Raising
+			; CLOCK again after every byte provides the high phase and hold time.
+			; Do not collapse these writes into adjacent high/low writes: the first
+			; hardware PORT-008 retry did so and produced sub-125 ns observed high
+			; phases which the P4 PARLIO receiver could not complete reliably.
+			LD	A, (_port008_active_high)
+			OUT0	(PD_DR), A
+PORT008_byte_loop:
+			LD	A, (HL)
+			OUT0	(PC_DR), A
+			LD	A, (_port008_active_low)
+			OUT0	(PD_DR), A			; Falling-edge sample
+			LD	A, (_port008_active_high)
+			OUT0	(PD_DR), A
+			INC	HL
+			DEC	BC
+			LD	A, B
+			OR	C
+			JR	NZ, PORT008_byte_loop
+			LD	A, (_port008_idle_high)		; VALID inactive, CLOCK high
+			OUT0	(PD_DR), A
 			LD	A, PORT008_WAIT_RELEASE
 			LD	(_port008_wait_windows), A
 			LD	BC, 0
