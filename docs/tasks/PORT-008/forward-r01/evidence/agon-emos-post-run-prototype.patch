+def validate_sender_storage(symbols: dict[str, int], disassembly: str) -> None:
+    """Bind ADL BC memory operands to a non-overlapping three-byte object."""
+    length = symbols.get("_port008_length")
+    idle_low = symbols.get("_port008_idle_low")
+    if length is None or idle_low is None:
+        raise Port008Error("linked EMOS image lacks PORT-008 length-state symbols")
+    if idle_low - length != 3:
+        raise Port008Error(
+            "_port008_length must occupy three bytes before _port008_idle_low"
+        )
+    ordered(
+        disassembly,
+        (
+            f"ld (0x{length:x}),bc",
+            f"ld a,(0x{length + 2:x})",
+            f"ld bc,(0x{length:x})",
+        ),
+        "linked 24-bit length storage and reload",
+    )
+
