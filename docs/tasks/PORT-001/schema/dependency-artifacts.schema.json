{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agon-extender.invalid/schema/dependency-artifacts-1.0.0.json",
  "title": "Agon Extender dependency graph artifacts",
  "description": "Review Gate 1 proposal for PORT-001.",
  "oneOf": [
    { "$ref": "#/$defs/codeGraph" },
    { "$ref": "#/$defs/graphOverlay" },
    { "$ref": "#/$defs/dependencySlice" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "argv"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "path": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "repository", "identity_kind", "identity", "commit", "root_placeholder"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "identity_kind": {
          "enum": ["tag", "release", "commit", "vendored-release", "framework"]
        },
        "identity": { "type": "string", "minLength": 1 },
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "root_placeholder": {
          "type": "string",
          "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$"
        }
      }
    },
    "inputArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "role", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "schema_version": { "type": ["string", "integer", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "metadataProperties": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "artifact_kind": {
          "enum": ["code_graph", "graph_overlay", "dependency_slice"]
        },
        "id": { "$ref": "#/$defs/id" },
        "generator": { "$ref": "#/$defs/generator" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceIdentity" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputArtifact" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool" }
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "path", "start_line", "end_line", "file_sha256", "span_sha256"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": ["string", "null"] },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "span_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "method", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "compile-database",
            "compiler-dependency",
            "compiler-diagnostic",
            "preprocessor",
            "symbol-index",
            "source-span",
            "official-documentation",
            "build-log",
            "test-result",
            "reviewed-analysis"
          ]
        },
        "method": { "enum": ["mechanical", "reviewed"] },
        "description": { "type": "string", "minLength": 1 },
        "span": { "$ref": "#/$defs/sourceSpan" },
        "artifact_id": { "$ref": "#/$defs/id" },
        "record_pointer": { "type": "string" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewed_on", "basis"],
          "properties": {
            "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] },
            "reviewed_on": { "type": "string", "format": "date" },
            "basis": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "reviewed" } } },
          "then": { "required": ["review"] }
        }
      ]
    },
    "namespacedProperties": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "owner", "label", "build_selection", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "command",
            "dispatch",
            "function",
            "method",
            "type",
            "macro",
            "variable",
            "file",
            "state",
            "callback",
            "task",
            "interrupt",
            "timer",
            "protocol-packet",
            "subsystem",
            "platform-api",
            "physical-facility",
            "resource",
            "build-unit",
            "test",
            "artifact"
          ]
        },
        "owner": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "build_selection": {
          "enum": ["selected", "available-not-selected", "external", "unknown"]
        },
        "qualified_name": { "type": ["string", "null"] },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceSpan" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "properties": { "$ref": "#/$defs/namespacedProperties" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "confidence", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "relation": {
          "enum": [
            "contains",
            "defines",
            "declares",
            "includes",
            "dispatches-to",
            "calls",
            "may-call",
            "reads",
            "writes",
            "owns",
            "resets",
            "configures",
            "constructs",
            "allocates",
            "creates-task",
            "invokes-callback",
            "sends-packet",
            "receives-packet",
            "depends-on",
            "requires-platform-api",
            "requires-hardware",
            "delegates-to",
            "affects"
          ]
        },
        "confidence": { "enum": ["confirmed", "strong", "tentative"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "properties": { "$ref": "#/$defs/namespacedProperties" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confidence": { "enum": ["strong", "tentative"] }
            }
          },
          "then": { "required": ["rationale"] }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_kind", "target_id", "namespace", "key", "value", "status", "evidence_ids"],
      "properties": {
        "target_kind": { "enum": ["node", "edge"] },
        "target_id": { "$ref": "#/$defs/id" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "value": {},
        "status": { "enum": ["proposed", "accepted", "superseded"] },
        "decision_ref": { "type": ["string", "null"] },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_kinds", "relations"],
      "properties": {
        "node_kinds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "graphReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "schema_version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "schema_version": { "const": "1.0.0" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "slicePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directions", "relations", "node_kinds", "maximum_depth", "stop_rules"],
      "properties": {
        "directions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["outgoing", "incoming"] },
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "node_kinds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "maximum_depth": { "type": "integer", "minimum": 0 },
        "stop_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "values", "reason"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["node-id", "node-kind", "relation", "subsystem", "depth"] },
              "values": { "type": "array", "items": { "type": ["string", "integer"] } },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "relation", "omitted_to", "stop_rule_id", "reason"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "relation": { "type": "string", "minLength": 1 },
        "omitted_to": { "$ref": "#/$defs/id" },
        "stop_rule_id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "continuation_slice": { "type": ["string", "null"] }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "evidence_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["symbol", "dispatch", "edge", "source", "ownership", "port-disposition"] },
        "description": { "type": "string", "minLength": 1 },
        "subject_id": { "$ref": "#/$defs/id" },
        "candidate_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "codeGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_kind", "id", "generator", "sources", "inputs", "tools", "vocabulary", "evidence", "nodes", "edges"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "artifact_kind": { "const": "code_graph" },
        "id": { "$ref": "#/$defs/id" },
        "generator": { "$ref": "#/$defs/generator" },
        "sources": { "$ref": "#/$defs/metadataProperties/properties/sources" },
        "inputs": { "$ref": "#/$defs/metadataProperties/properties/inputs" },
        "tools": { "$ref": "#/$defs/metadataProperties/properties/tools" },
        "vocabulary": { "$ref": "#/$defs/vocabulary" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } }
      }
    },
    "graphOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_kind", "id", "sources", "inputs", "tools", "target_graph", "evidence", "nodes", "edges", "annotations"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "artifact_kind": { "const": "graph_overlay" },
        "id": { "$ref": "#/$defs/id" },
        "generator": { "$ref": "#/$defs/generator" },
        "sources": { "$ref": "#/$defs/metadataProperties/properties/sources" },
        "inputs": { "$ref": "#/$defs/metadataProperties/properties/inputs" },
        "tools": { "$ref": "#/$defs/metadataProperties/properties/tools" },
        "target_graph": { "$ref": "#/$defs/graphReference" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } }
      }
    },
    "dependencySlice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_kind", "id", "generator", "sources", "inputs", "tools", "source_graph", "title", "seed_nodes", "policy", "evidence", "nodes", "edges", "groups", "boundaries", "unresolved", "summary"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "artifact_kind": { "const": "dependency_slice" },
        "id": { "$ref": "#/$defs/id" },
        "generator": { "$ref": "#/$defs/generator" },
        "sources": { "$ref": "#/$defs/metadataProperties/properties/sources" },
        "inputs": { "$ref": "#/$defs/metadataProperties/properties/inputs" },
        "tools": { "$ref": "#/$defs/metadataProperties/properties/tools" },
        "source_graph": { "$ref": "#/$defs/graphReference" },
        "title": { "type": "string", "minLength": 1 },
        "seed_nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "policy": { "$ref": "#/$defs/slicePolicy" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/id" }
          }
        },
        "boundaries": { "type": "array", "items": { "$ref": "#/$defs/boundary" } },
        "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_count", "edge_count", "boundary_count", "unresolved_count"],
          "properties": {
            "node_count": { "type": "integer", "minimum": 0 },
            "edge_count": { "type": "integer", "minimum": 0 },
            "boundary_count": { "type": "integer", "minimum": 0 },
            "unresolved_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
