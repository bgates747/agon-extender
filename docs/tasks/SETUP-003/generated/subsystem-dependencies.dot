digraph subsystem_dependencies {
  rankdir=LR;
  graph [label="Reviewed runtime subsystem dependencies", labelloc=t, fontsize=18, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, fillcolor="#eaf2ff"];
  edge [fontname="DejaVu Sans", fontsize=8, color="#667085", fontcolor="#475467", arrowsize=0.7];
  "audio" [label="audio\nunconditional-initialization-command-driven"];
  "debug-zdi-and-file-transfer" [label="debug-zdi-and-file-transfer\ncommand-or-console-activated"];
  "dependency-source-selection" [label="dependency-source-selection\nbuild-time-selection-with-mixed-runtime-reachability"];
  "firmware-updater" [label="firmware-updater\ncommand-activated"];
  "graphics-display" [label="graphics-display\nunconditional-startup-and-command-driven"];
  "memory-and-psram" [label="memory-and-psram\npervasive-support-layer"];
  "physical-ps2-input" [label="physical-ps2-input\nunconditional-initialization-continuous-polling"];
  "primary-vdp-transport" [label="primary-vdp-transport\nunconditional-startup"];
  "rtc-service" [label="rtc-service\ncommand-driven"];
  "runtime-concurrency" [label="runtime-concurrency\ncross-cutting"];
  "startup-orchestration" [label="startup-orchestration\nunconditional-startup"];
  "terminal-mode" [label="terminal-mode\ncommand-activated"];
  "audio" -> "memory-and-psram" [label="stores samples in"];
  "audio" -> "runtime-concurrency" [label="creates task and isr"];
  "debug-zdi-and-file-transfer" -> "memory-and-psram" [label="stores transfer files in"];
  "debug-zdi-and-file-transfer" -> "physical-ps2-input" [label="polls for abort"];
  "debug-zdi-and-file-transfer" -> "primary-vdp-transport" [label="reuses packet channel"];
  "firmware-updater" -> "graphics-display" [label="quiesces"];
  "firmware-updater" -> "primary-vdp-transport" [label="receives image over"];
  "graphics-display" -> "memory-and-psram" [label="allocates through"];
  "graphics-display" -> "runtime-concurrency" [label="creates task and isr"];
  "physical-ps2-input" -> "graphics-display" [label="uses cursor and positioner"];
  "physical-ps2-input" -> "primary-vdp-transport" [label="emits input packets"];
  "physical-ps2-input" -> "runtime-concurrency" [label="creates tasks and isr"];
  "rtc-service" -> "primary-vdp-transport" [label="returns packets over"];
  "startup-orchestration" -> "audio" [label="starts"];
  "startup-orchestration" -> "graphics-display" [label="starts"];
  "startup-orchestration" -> "physical-ps2-input" [label="starts"];
  "startup-orchestration" -> "primary-vdp-transport" [label="starts"];
  "terminal-mode" -> "graphics-display" [label="renders through"];
  "terminal-mode" -> "physical-ps2-input" [label="defaults to keyboard"];
  "terminal-mode" -> "primary-vdp-transport" [label="connects to"];
  "terminal-mode" -> "runtime-concurrency" [label="creates timer queue tasks"];
}
