(text "Olimex ESP32-P4-DevKit Rev D1" (at 221 29.21 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid 40e305c7-eefd-5dc1-bd11-2ec2ff070b1b))
(text "Remaining header contacts" (at 320.04 29.21 0) (effects (font (size 1.524 1.524)) (justify left)) (uuid ead69c35-b653-5c8f-a437-5822a93a406f))
(text "Header units are grouped by function; numbers are physical pins. This is an electrical drawing, not a breadboard layout." (at 15.24 278.13 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 799b1eb3-00fc-57ad-b4ee-092ee1db17d7))
(text "Pull-ups: AGON_3V3 only, drawn on the Agon side of each series resistor. P4 positive supplies have no harness connection." (at 15.24 283.21 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 42c04916-3d42-57af-8a5e-f13a47b55577))
(text "Required common ground: J1.33 to EXT1.2. Confirm the actual connection and point-to-point mapping before treating this as as-built." (at 15.24 288.29 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid 1a179f1c-d28f-5d9d-928b-9612e0401959))
